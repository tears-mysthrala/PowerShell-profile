# PowerShell Profile Repository .gitignore
# Optimized for PowerShell development environment

# AI assistant dotfiles (settings, transcripts, memory)
.claude/

# Secrets and credentials — never commit these
.env
.env.*
*.pem
*.key
*.pfx
*.p12
*.credential
*_rsa
*_ed25519
*_ecdsa
*_dsa

# PowerShell specific
*.log
*.tmp
*.tmp-*
.tmp

# PowerShell cache files (do not track runtime caches)
Config/*.clixml
utils-cache.clixml
ModuleCache/

# Generated tool init caches (regenerated automatically at profile load)
Config/*-cache.ps1

# Generated analysis reports (PSScriptAnalyzer and similar tooling)
pssa_*.json
*-pssa-report*.json
*.sarif

# Runtime state databases
.zo/

# Generated help files (regenerated by workflow)
Help/

# Starship runtime folder (generated)
.starship/

# Third-party modules (exclude all except explicitly maintained ones)
Modules/*
!Modules/Profile.Commands/
!Modules/Profile.Commands/Profile.Commands.psd1
!Modules/Profile.Commands/Profile.Commands.psm1
!Modules/Profile.Chezmoi/
!Modules/Profile.Chezmoi/Profile.Chezmoi.psd1
!Modules/Profile.Chezmoi/Profile.Chezmoi.psm1
!Modules/Profile.Update/
!Modules/Profile.Update/Profile.Update.psd1
!Modules/Profile.Update/Profile.Update.psm1

# Development and testing artifacts
test-results/
coverage/
*.test
*.spec

# OS and Editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~

# Backup files
*.bak
*.backup
*.old
*.new

# Archive and compressed files (except release archives)
*.zip
*.tar.gz
*.7z
!powershell-profile-*.tar.gz

# Temporary files and directories
tmp/
temp/
.cache/

# Windows specific
$RECYCLE.BIN/
System Volume Information/
ehthumbs.db
Icon?
*.stackdump

# CI/CD artifacts
.github/workflows/*.sarif
results.sarif
devskim-results.sarif

# .NET tool cache (local installations)
tools/.store/
